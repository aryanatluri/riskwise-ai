# Leave empty to call the API on the same origin (Vite proxies /api to localhost:8000 in dev).
VITE_API_URL=
# "dev" = email-only sign-in against /api/v1/dev/token (local only)
# "supabase" = magic-link sign-in with Supabase Auth (hosted)
VITE_AUTH_MODE=dev
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
