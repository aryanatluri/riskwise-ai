# --- Core ---------------------------------------------------------------
ENV=prod
POSTGRES_PASSWORD=change-me
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Auth (OIDC) ----------------------------------------------------------
# Hosted (Supabase Auth):  issuer https://<project>.supabase.co/auth/v1
#                          jwks   https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# Self-hosted (Azure AD):  issuer https://login.microsoftonline.com/<tenant>/v2.0
AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=

# --- Jobs (hourly SLA sweep) ---------------------------------------------
JOB_TOKEN=

# --- Email for SLA escalations (any SMTP relay) ----------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=RISKWISE AI <no-reply@example.com>

CORS_ORIGINS=["https://app.example.com"]
